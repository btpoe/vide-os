{
  "name": "vide-os",
  "version": "0.1.0",
  "description": "Browser-based video editor with WebGL shaders and Web Components",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "test:perf": "vitest run -c vitest.perf.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:perf && pnpm build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "mediabunny": "^1.52.3",
    "mutative": "^1.3.0",
    "solid-js": "^1.9.3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^4.1.10"
  }
}
